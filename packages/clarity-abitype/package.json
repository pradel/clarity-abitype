{
  "name": "clarity-abitype",
  "version": "0.5.0",
  "description": "Strict TypeScript types for Stacks Clarity ABIs",
  "license": "MIT",
  "repository": "pradel/clarity-abitype",
  "funding": "https://github.com/sponsors/pradel",
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./clarinet-sdk": "./dist/clarinet-sdk/index.js",
    "./stacks-js": "./dist/stacks-js/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.2",
    "@stacks/clarinet-sdk": "3.13.1",
    "@stacks/common": "7.3.1",
    "@stacks/network": "7.3.1",
    "@stacks/transactions": "7.3.1",
    "publint": "0.3.16",
    "typescript": "5.9.3",
    "vite-plus": "0.1.15"
  },
  "peerDependencies": {
    "@stacks/clarinet-sdk": ">= 3.0.0",
    "@stacks/network": ">= 7.3.0",
    "@stacks/transactions": ">= 7.3.0",
    "typescript": ">=5.1.0"
  },
  "peerDependenciesMeta": {
    "@stacks/clarinet-sdk": {
      "optional": true
    },
    "@stacks/network": {
      "optional": true
    },
    "@stacks/transactions": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
