{
  "name": "clarity-abitype",
  "version": "0.6.0",
  "description": "Strict TypeScript types for Stacks Clarity ABIs",
  "license": "MIT",
  "repository": "pradel/clarity-abitype",
  "funding": "https://github.com/sponsors/pradel",
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./clarinet-sdk": "./dist/clarinet-sdk/index.js",
    "./stacks-connect": "./dist/stacks-connect/index.js",
    "./stacks-js": "./dist/stacks-js/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@stacks/clarinet-sdk": "^3.23.2",
    "@stacks/common": "7.6.0",
    "@stacks/connect": "^8.2.7",
    "@stacks/network": "^7.6.0",
    "@stacks/transactions": "^7.6.0",
    "publint": "0.3.24",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@stacks/clarinet-sdk": ">= 3.0.0",
    "@stacks/connect": ">= 8.0.0",
    "@stacks/network": ">= 7.3.0",
    "@stacks/transactions": ">= 7.3.0",
    "typescript": ">=5.4.0 || >=6.0.0 || >=7.0.0"
  },
  "peerDependenciesMeta": {
    "@stacks/clarinet-sdk": {
      "optional": true
    },
    "@stacks/connect": {
      "optional": true
    },
    "@stacks/network": {
      "optional": true
    },
    "@stacks/transactions": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
