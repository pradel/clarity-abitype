{
  "name": "clarity-abitype",
  "version": "0.3.1",
  "license": "MIT",
  "description": "Strict TypeScript types for Stacks Clarity ABIs",
  "repository": "pradel/clarity-abitype",
  "sideEffects": false,
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "test": "vitest"
  },
  "peerDependencies": {
    "@stacks/clarinet-sdk": ">= 3.0.0",
    "@stacks/network": ">= 7.3.0",
    "@stacks/transactions": ">= 7.3.0",
    "typescript": ">=5.1.0"
  },
  "peerDependenciesMeta": {
    "@stacks/clarinet-sdk": {
      "optional": true
    },
    "@stacks/network": {
      "optional": true
    },
    "@stacks/transactions": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.2",
    "@stacks/clarinet-sdk": "3.13.1",
    "@stacks/common": "7.3.1",
    "@stacks/network": "7.3.1",
    "@stacks/transactions": "7.3.1",
    "@tsconfig/node22": "22.0.5",
    "@tsconfig/recommended": "1.0.13",
    "publint": "0.3.16",
    "tsdown": "0.19.0",
    "typescript": "5.9.3",
    "vitest": "4.0.17"
  },
  "funding": "https://github.com/sponsors/pradel"
}
