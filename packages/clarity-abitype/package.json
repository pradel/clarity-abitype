{
  "name": "clarity-abitype",
  "version": "0.1.5",
  "license": "MIT",
  "description": "Strict TypeScript types for Stacks Clarity ABIs",
  "repository": "pradel/clarity-abitype",
  "sideEffects": false,
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "test": "vitest"
  },
  "peerDependencies": {
    "typescript": ">=5.1.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.5",
    "@tsconfig/recommended": "1.0.13",
    "publint": "0.3.16",
    "tsdown": "0.18.0",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "funding": "https://github.com/sponsors/pradel"
}
