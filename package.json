{
  "name": "clarity-abitype-root",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for clarity-abitype",
  "scripts": {
    "ready": "vp fmt && vp run -r build && vp lint && vp run -r test",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "prepare": "vp config",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "vp run build && cp README.md ./packages/clarity-abitype && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.24.0"
}
